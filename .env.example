# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored. Never commit real ARNs or tokens.

# ---- Required: AWS Bedrock access ----
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# ---- Required: GitHub (fork/clone/push operations) ----
GITHUB_TOKEN=

# ---- Optional: OpenAI (only needed for the `gpt54` alias) ----
OPENAI_API_KEY=

# ---- Optional: Bedrock inference-profile ARNs ----
# Only fill in the ones you actually use. A missing ARN fails only if you
# invoke its alias (e.g. `--model glm5`). Format:
#   bedrock/converse/arn:aws:bedrock:<region>:<account>:application-inference-profile/<id>
BEDROCK_OPUS_ARN=
BEDROCK_OPUS47_ARN=
BEDROCK_KIMI_ARN=
BEDROCK_GLM5_ARN=
BEDROCK_MINIMAX_ARN=
BEDROCK_NOVA_PREMIER_ARN=
BEDROCK_NOVA2_LITE_ARN=

# ---- Optional: Bedrock test ARN (agent/tests/live_summarizer_test.py) ----
BEDROCK_TEST_ARN=
SPEC_SUMMARY_MODEL=

# ---- Optional: Google Vertex AI Gemini ----
# Express Mode (single API key, recommended for benchmarks).
# Setting this enables the `gemini` / `gemini31` aliases. Without it, those
# aliases fail at preflight with a clear error.
VERTEX_AI_API_KEY=
# SA JSON / ADC auth (alternative to VERTEX_AI_API_KEY).
# Point this to a Service Account JSON key file downloaded from GCP IAM.
# google.auth.default() picks it up automatically; no VERTEX_AI_API_KEY needed.
GOOGLE_APPLICATION_CREDENTIALS=
# REQUIRED for all vertex_ai/* models: regional endpoints return HTTP 404 for
# this GCP project. The global endpoint (aiplatform.googleapis.com) is required.
VERTEXAI_LOCATION=global
# Google AI Studio key (for gemini/* prefix models instead of vertex_ai/*).
GOOGLE_API_KEY=

# ---- Optional: Headroom prompt compression ----
# Enabled by default when the `headroom-ai` package is installed. Set to
# false to disable without uninstalling. All knobs are best-effort: a bad
# value falls back to the listed default; the agent NEVER fails on Headroom
# errors -- the original messages flow through unchanged.
KAIJU_HEADROOM_ENABLED=true
# Target compression ratio (0.0..1.0). Lower = more aggressive.
KAIJU_HEADROOM_TARGET_RATIO=0.4
# Skip compression entirely when the message list is below this token count.
KAIJU_HEADROOM_MIN_TOKENS=2000
# Number of most-recent messages to leave untouched (preserve tool outputs).
KAIJU_HEADROOM_PROTECT_RECENT=2
