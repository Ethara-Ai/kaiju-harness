# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored. Never commit real ARNs or tokens.

# ---- Required: AWS Bedrock access ----
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# ---- Required: GitHub (fork/clone/push operations) ----
GITHUB_TOKEN=

# ---- Optional: OpenAI (needed for the `gpt54` and `gpt55` aliases) ----
OPENAI_API_KEY=

# ---- Optional: Bedrock inference-profile ARNs ----
# Only fill in the ones you actually use. A missing ARN fails only if you
# invoke its alias (e.g. `--model glm5`). Format:
#   bedrock/converse/arn:aws:bedrock:<region>:<account>:application-inference-profile/<id>
BEDROCK_OPUS_ARN=
BEDROCK_OPUS47_ARN=
BEDROCK_KIMI_ARN=
BEDROCK_GLM5_ARN=
BEDROCK_MINIMAX_ARN=
BEDROCK_NOVA_PREMIER_ARN=
BEDROCK_NOVA2_LITE_ARN=

# ---- Optional: Bedrock test ARN (agent/tests/live_summarizer_test.py) ----
BEDROCK_TEST_ARN=
SPEC_SUMMARY_MODEL=

# ---- Optional: Google Vertex AI Gemini ----
# Express Mode (single API key, recommended for benchmarks).
# Setting this enables the `gemini` / `gemini31` aliases. Without it, those
# aliases fail at preflight with a clear error.
VERTEX_AI_API_KEY=
# SA JSON / ADC auth (alternative to VERTEX_AI_API_KEY).
# Point this to a Service Account JSON key file downloaded from GCP IAM.
# google.auth.default() picks it up automatically; no VERTEX_AI_API_KEY needed.
GOOGLE_APPLICATION_CREDENTIALS=
# REQUIRED for all vertex_ai/* models: regional endpoints return HTTP 404 for
# this GCP project. The global endpoint (aiplatform.googleapis.com) is required.
VERTEXAI_LOCATION=global
# Google AI Studio key (for gemini/* prefix models instead of vertex_ai/*).
GOOGLE_API_KEY=

# ---- Optional: Claude Code OAuth Bridge ----
# Route Anthropic traffic through your Claude Code subscription (no API key)
# via a local proxy. See docs/CLAUDE_CODE_BRIDGE.md and
# scripts/claude_code_bridge.sh. Credentials are read from macOS Keychain
# (service "Claude Code-credentials"), so these env vars are usually unset.
KAIJU_CC_BRIDGE_HOST=127.0.0.1
KAIJU_CC_BRIDGE_PORT=8765
# Override the credentials source for CI (path to a JSON file).
KAIJU_CC_CREDS_PATH=
# Set to 1 to disable the "You are Claude Code" system-prefix injection.
# Only useful for debugging the bridge; Anthropic rejects OAuth calls without it.
KAIJU_CC_SKIP_SYSTEM_PREFIX=
# Multi-account pool: colon-separated list of credential sources. Bridge fails
# over to the next account when one hits the 5h/weekly subscription cap. Each
# entry is one of: a file path (JSON cred blob), 'keychain:<service-name>', or
# 'default' (= Keychain + ~/.claude/.credentials.json + refresh cache).
# Example: $HOME/.cache/kaiju-harness/acc1.json:$HOME/.cache/kaiju-harness/acc2.json:default
KAIJU_CC_ACCOUNT_POOL=
# Bridge-level retry tuning for transient 429/529 errors. Defaults: 3 retries,
# max 30s inline wait per retry. Set 0 to disable bridge-level retry entirely.
KAIJU_CC_MAX_INLINE_RETRIES=
KAIJU_CC_MAX_INLINE_WAIT=
# Watchdog: monitor polls /healthz and restarts the bridge after N consecutive
# failures. Defaults: 30s poll, 3 failures = restart. Set KAIJU_CC_DISABLE_MONITOR=1
# in `scripts/claude_code_bridge.sh start` to skip the monitor.
KAIJU_CC_MONITOR_POLL=
KAIJU_CC_MONITOR_FAILS=
KAIJU_CC_DISABLE_MONITOR=
# Set to 1 to make run_pipeline.sh auto-start/stop the bridge (equivalent to
# passing --use-claude-code on the CLI).
KAIJU_USE_CLAUDE_CODE=
