# NOTE: __RUST_VERSION__ / __CARGO_NEXTEST_VERSION__ are substituted by
# get_dockerfile_base_rust() from constants_rust.py so the toolchain versions
# have a SINGLE source of truth (no silent drift between the constant and the
# image).
#
# SECURITY/REPRODUCIBILITY (tracked, not yet applied — requires a Docker build
# env to verify):
#   * Pin the base by digest for byte-reproducible builds. To obtain it:
#       docker pull rust:__RUST_VERSION__-bookworm
#       docker inspect --format='{{index .RepoDigests 0}}' rust:__RUST_VERSION__-bookworm
#     then set RUST_BASE_DIGEST in constants_rust.py and append `@${digest}`.
#   * This image compiles+runs arbitrary repo code (build.rs/proc-macros) as
#     root. A non-root USER is desirable but the harness setup currently assumes
#     root (chmod 777, /root paths); switching needs an end-to-end build test.
FROM rust:__RUST_VERSION__-bookworm

ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive
ARG http_proxy=""
ARG https_proxy=""
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG no_proxy="localhost,127.0.0.1,::1"
ARG NO_PROXY="localhost,127.0.0.1,::1"
ARG CA_CERT_PATH="/etc/ssl/certs/ca-certificates.crt"

# Proxy values are intentionally NOT promoted to ENV: proxy URLs often embed
# credentials (http://user:pass@host) and ENV persists them into every image
# layer (visible via `docker history`/`docker inspect`). Docker passes the
# predefined proxy ARGs to RUN steps during build automatically, so apt/curl
# still use them without baking them into the shipped image.
ENV TZ=Etc/UTC \
    LANG=C.UTF-8 \
    SSL_CERT_FILE=${CA_CERT_PATH} \
    REQUESTS_CA_BUNDLE=${CA_CERT_PATH} \
    CURL_CA_BUNDLE=${CA_CERT_PATH} \
    NODE_EXTRA_CA_CERTS=${CA_CERT_PATH} \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo

ENV PATH=${CARGO_HOME}/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    git-lfs \
    git \
    build-essential \
    ca-certificates \
    curl \
    wget \
    jq \
    locales \
    locales-all \
    tzdata \
    pkg-config \
    libssl-dev \
    cmake \
    clang \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*


# git-lfs: materialize spec.pdf.bz2 when it was pushed via LFS (specs >100 MiB).
# `git lfs install --system` registers the smudge filter so the repo-image clone
# transparently downloads the LFS-backed blob. Inert for the common (non-LFS) repo.
RUN git lfs install --system
# rustup/cargo/rustc are provided by the rust:<ver>-bookworm base image.
# Add the components and binaries the harness relies on:
#   - rustfmt + clippy: required for Stage 2 (lint refine)
#   - cargo-nextest:    used by the Rust test runner (JSON output parsing)
# Install nextest from its prebuilt per-arch binary instead of `cargo install`
# (source compile), which fails under QEMU emulation during multi-arch builds.
# Pin to __CARGO_NEXTEST_VERSION__ (NOT `latest`) so the JSON event schema the
# test runner parses can't change underneath us, and assert the install matches.
RUN rustup component add rustfmt clippy && \
    case "${TARGETARCH}" in \
      arm64) NEXTEST_PLATFORM=linux-arm ;; \
      *)     NEXTEST_PLATFORM=linux ;; \
    esac && \
    curl -LsSf "https://get.nexte.st/__CARGO_NEXTEST_VERSION__/${NEXTEST_PLATFORM}" | tar zxf - -C ${CARGO_HOME}/bin && \
    cargo --version && \
    cargo nextest --version && \
    { cargo nextest --version | grep -q "__CARGO_NEXTEST_VERSION__" \
        || { echo "FATAL: cargo-nextest version mismatch (expected __CARGO_NEXTEST_VERSION__)" >&2; exit 1; }; }
# rustc/rustfmt/clippy --version checks are omitted on purpose: those binaries
# SIGSEGV under qemu-user during the emulated amd64 multi-arch build (cargo and
# nextest run fine). The components are installed above and work natively when
# the amd64 image runs on real amd64 hardware.

# Cross-distro SSL cert symlinks for libraries that look in RHEL/Fedora paths
RUN mkdir -p /etc/pki/tls/certs /etc/pki/tls /etc/pki/ca-trust/extracted/pem /etc/ssl/certs && \
    ln -sf /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt 2>/dev/null; \
    ln -sf /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem 2>/dev/null; \
    ln -sf /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/cert.pem 2>/dev/null; \
    ln -sf /etc/ssl/certs/ca-certificates.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem 2>/dev/null; \
    true

# MITM CA cert injection via BuildKit secret (only applied if secret is provided)
RUN --mount=type=secret,id=mitm_ca,required=false \
    if [ -f /run/secrets/mitm_ca ]; then \
        cp /run/secrets/mitm_ca /usr/local/share/ca-certificates/mitm-ca.crt && \
        update-ca-certificates && \
        echo "MITM CA certificate installed successfully"; \
    else \
        echo "No MITM CA certificate found, skipping"; \
    fi
